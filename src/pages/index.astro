---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { Image } from 'astro:assets';
import heroBgImg from '@assets/images/PHOTO 13.jpg';
import lifecycleImg from '@assets/images/lifecycle.webp';
import ind1Img from '@assets/images/industrial.webp';
import ind2Img from '@assets/images/commercial_buildings.webp';
import ind3Img from '@assets/images/oil_and_gas.webp';
import ind4Img from '@assets/images/stadium.webp';
import ind5Img from '@assets/images/warehouse.webp';
import ind6Img from '@assets/images/miscellaneous_and_architectural_steel.webp';
---

<BaseLayout title="Steel Detailing Services | Precision 3D Modeling" description="Expert structural steel detailing, 3D modeling, and fabrication drawings using Tekla Structures. Serving Australian steel fabricators, EPC contractors, and structural consultants.">

  <!-- Hero Section -->
  <section class="relative min-h-[85vh] bg-zinc-950 border-b border-zinc-800 overflow-hidden flex items-center">
    <!-- Full-bleed background image -->
    <div class="absolute inset-0">
      <Image
        src={heroBgImg}
        alt="Engineering Confidence into Every Steel Structure"
        class="w-full h-full object-cover object-center"
        width={1920}
        height={1080}
        decoding="async"
        fetchpriority="high"
      />
      <!-- Gradient: dense zinc-950 on the left fading to near-transparent on the right -->
      <div class="absolute inset-0 bg-linear-to-r from-zinc-950 from-30% via-zinc-950/80 via-55% to-zinc-950/10"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 container mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 py-24 animate-fadeInUp">
      <div class="max-w-2xl">

        <div class="inline-flex items-center px-4 py-2 border border-orange-500/70 bg-zinc-900/70 text-orange-400 text-sm font-semibold rounded-sm mb-8 backdrop-blur-sm">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          3D Structure
        </div>

        <h1 class="text-5xl md:text-6xl font-bold text-white leading-tight mb-6">
          Engineering Confidence into Every
          <span class="block text-transparent bg-clip-text bg-linear-to-r from-orange-500 to-orange-400 mt-1">
            Steel Structure
          </span>
        </h1>

        <p class="text-lg text-zinc-300 max-w-lg leading-relaxed mb-8">
          Specialist structural steel detailing and BIM modeling delivering technically robust, fabrication-ready solutions. Operating as an extended engineering partner to steel fabricators, EPC contractors, and structural consultants.
        </p>

        <a
          href={`${import.meta.env.BASE_URL}contact#contact-form-container`}
          class="inline-flex items-center px-8 py-3.5 text-sm font-semibold text-white bg-orange-500 hover:bg-orange-600 rounded-lg shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 mb-12"
        >
          Work With Us
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>

        <!-- Metrics -->
        <div class="pt-8 border-t border-zinc-700/80">
          <div class="grid grid-cols-3 gap-x-8 gap-y-10">
            <div class="border-l-[3px] border-orange-500 pl-4 group">
              <div class="text-3xl font-bold text-white tracking-tight">40+</div>
              <div class="text-sm text-zinc-400 mt-1 group-hover:text-orange-400 transition-colors leading-snug">Structural Engineers</div>
            </div>
            <div class="border-l-[3px] border-orange-500 pl-4 group">
              <div class="text-3xl font-bold text-white tracking-tight">12</div>
              <div class="text-sm text-zinc-400 mt-1 group-hover:text-orange-400 transition-colors leading-snug">Tekla Licenses</div>
            </div>
            <div class="border-l-[3px] border-orange-500 pl-4 group">
              <div class="text-3xl font-bold text-white tracking-tight">QA</div>
              <div class="text-sm text-zinc-400 mt-1 group-hover:text-orange-400 transition-colors leading-snug">Multi-Level Quality Assurance</div>
            </div>
            <div class="border-l-[3px] border-orange-500 pl-4 group">
              <div class="text-3xl font-bold text-white tracking-tight">Teams</div>
              <div class="text-sm text-zinc-400 mt-1 group-hover:text-orange-400 transition-colors leading-snug">Scalable Project Integration</div>
            </div>
            <div class="border-l-[3px] border-orange-500 pl-4 group">
              <div class="text-3xl font-bold text-white tracking-tight">Secure</div>
              <div class="text-sm text-zinc-400 mt-1 group-hover:text-orange-400 transition-colors leading-snug">Digital Collaboration</div>
            </div>
            <div class="border-l-[3px] border-orange-500 pl-4 group">
              <div class="text-3xl font-bold text-white tracking-tight">24/7</div>
              <div class="text-sm text-zinc-400 mt-1 group-hover:text-orange-400 transition-colors leading-snug">Operational Infrastructure</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- Our Role Section -->
  <section class="bg-orange-50/40 overflow-hidden border-t border-orange-100">
    <div class="flex flex-col lg:flex-row min-h-[680px]">

      <!-- Left: Content -->
      <div class="w-full lg:w-[54%] px-6 sm:px-10 lg:pl-16 xl:pl-20 py-20 flex flex-col justify-center">

        <p class="text-xs font-bold text-orange-500 uppercase tracking-widest mb-4">Our Role</p>
        <h2 class="text-3xl md:text-5xl font-bold text-zinc-900 leading-tight mb-5">
          In the Construction<br class="hidden md:block" /> Lifecycle
        </h2>
        <p class="text-zinc-500 text-lg leading-relaxed mb-12 max-w-lg">
          We bridge the gap between structural design and the workshop floor — acting as your offshore detailing partner from initial model through to fabrication-ready output.
        </p>

        <!-- Timeline -->
        <div class="relative">
          <div class="absolute left-[19px] top-3 bottom-3 w-px bg-zinc-200"></div>
          <div class="space-y-8">

            <div class="flex items-start gap-5">
              <div class="shrink-0 w-10 h-10 rounded-full bg-orange-500 text-white text-xs font-bold flex items-center justify-center z-10 shadow-md shadow-orange-200">01</div>
              <div class="pt-1.5">
                <h4 class="font-bold text-zinc-900">Design Receipt & Review</h4>
                <p class="text-zinc-500 text-sm mt-1 leading-relaxed">We receive structural design packages — GA drawings, specifications, and connection details — and align on scope before modelling begins.</p>
              </div>
            </div>

            <div class="flex items-start gap-5">
              <div class="shrink-0 w-10 h-10 rounded-full bg-white border-2 border-orange-300 text-orange-500 text-xs font-bold flex items-center justify-center z-10">02</div>
              <div class="pt-1.5">
                <h4 class="font-bold text-zinc-900">3D Steel Modelling</h4>
                <p class="text-zinc-500 text-sm mt-1 leading-relaxed">Full structural models built in Tekla Structures — precise member sizing, connection geometry, and clash coordination with other disciplines.</p>
              </div>
            </div>

            <div class="flex items-start gap-5">
              <div class="shrink-0 w-10 h-10 rounded-full bg-white border-2 border-orange-300 text-orange-500 text-xs font-bold flex items-center justify-center z-10">03</div>
              <div class="pt-1.5">
                <h4 class="font-bold text-zinc-900">Shop Drawings & Detailing</h4>
                <p class="text-zinc-500 text-sm mt-1 leading-relaxed">Fabrication drawings, assembly marks, and erection plans produced and reviewed against your standards before issue for approval.</p>
              </div>
            </div>

            <div class="flex items-start gap-5">
              <div class="shrink-0 w-10 h-10 rounded-full bg-white border-2 border-orange-300 text-orange-500 text-xs font-bold flex items-center justify-center z-10">04</div>
              <div class="pt-1.5">
                <h4 class="font-bold text-zinc-900">IFC, CNC & Final Delivery</h4>
                <p class="text-zinc-500 text-sm mt-1 leading-relaxed">IFC-compliant models, CNC files, and BOMs issued directly to your fabrication team — everything the workshop needs, nothing it doesn't.</p>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Right: Image with left-blend gradient -->
      <div class="w-full lg:w-[46%] relative h-72 lg:h-auto">
        <Image
          src={lifecycleImg}
          alt="Steel construction lifecycle"
          class="w-full h-full object-cover"
        />
        <!-- Blend left edge into bg on desktop -->
        <div class="absolute inset-0 bg-linear-to-r from-orange-50 via-orange-50/20 to-transparent hidden lg:block"></div>
        <!-- Blend top edge on mobile -->
        <div class="absolute inset-0 bg-linear-to-b from-orange-50 via-orange-50/20 to-transparent lg:hidden"></div>
        <!-- Orange top accent bar -->
        <div class="absolute top-0 left-0 right-0 h-[3px] bg-orange-500"></div>
      </div>

    </div>
  </section>

  <!-- Industries Served Section -->
  <section class="py-24 bg-white border-t border-orange-100">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-zinc-900 mb-6 tracking-tight">Industries We Serve</h2>
        <p class="text-lg text-zinc-600 leading-relaxed">
          Delivering specialized structural detailing across a diverse range of sectors, ensuring compliance with industry-specific standards and operational requirements.
        </p>
      </div>

      <div class="space-y-5 max-w-6xl mx-auto">

        <!-- Industry 1 — image left -->
        <div class="flex flex-col md:flex-row overflow-hidden rounded-2xl border border-orange-100 shadow-sm shadow-orange-200/30 hover:shadow-md hover:shadow-orange-200/40 hover:border-orange-300 transition-all duration-300 group h-auto md:h-60">
          <div class="w-full md:w-2/5 h-52 md:h-full relative overflow-hidden shrink-0">
            <Image src={ind1Img} alt="Industrial Structures" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-zinc-950/25 group-hover:bg-zinc-950/15 transition-colors duration-300"></div>
          </div>
          <div class="flex-1 flex flex-col justify-center px-8 py-7 bg-orange-50/40">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-orange-50 text-orange-700 border border-orange-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
              </div>
              <span class="text-xs font-semibold text-orange-600 uppercase tracking-widest">Sector 01</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-900 mb-2">Industrial Structures</h3>
            <div class="w-10 h-0.5 bg-orange-500 mb-3"></div>
            <p class="text-zinc-500 text-sm leading-relaxed">Heavy-duty structural frameworks for manufacturing plants, process facilities, and industrial complexes built to exacting tolerances.</p>
          </div>
        </div>

        <!-- Industry 2 — image right -->
        <div class="flex flex-col md:flex-row-reverse overflow-hidden rounded-2xl border border-orange-100 shadow-sm shadow-orange-200/30 hover:shadow-md hover:shadow-orange-200/40 hover:border-orange-300 transition-all duration-300 group h-auto md:h-60">
          <div class="w-full md:w-2/5 h-52 md:h-full relative overflow-hidden shrink-0">
            <Image src={ind2Img} alt="Commercial Buildings" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-zinc-950/25 group-hover:bg-zinc-950/15 transition-colors duration-300"></div>
          </div>
          <div class="flex-1 flex flex-col justify-center px-8 py-7 bg-orange-50/40">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-orange-50 text-orange-700 border border-orange-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"></path></svg>
              </div>
              <span class="text-xs font-semibold text-orange-600 uppercase tracking-widest">Sector 02</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-900 mb-2">Commercial Buildings</h3>
            <div class="w-10 h-0.5 bg-orange-500 mb-3"></div>
            <p class="text-zinc-500 text-sm leading-relaxed">Multi-storey office towers, retail centres, and mixed-use developments with complex steel framing and facade integration.</p>
          </div>
        </div>

        <!-- Industry 3 — image left -->
        <div class="flex flex-col md:flex-row overflow-hidden rounded-2xl border border-orange-100 shadow-sm shadow-orange-200/30 hover:shadow-md hover:shadow-orange-200/40 hover:border-orange-300 transition-all duration-300 group h-auto md:h-60">
          <div class="w-full md:w-2/5 h-52 md:h-full relative overflow-hidden shrink-0">
            <Image src={ind3Img} alt="Oil & Gas Facilities" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-zinc-950/25 group-hover:bg-zinc-950/15 transition-colors duration-300"></div>
          </div>
          <div class="flex-1 flex flex-col justify-center px-8 py-7 bg-orange-50/40">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-orange-50 text-orange-700 border border-orange-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.99 7.99 0 0120 13a7.98 7.98 0 01-2.343 5.657z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14l.879 2.121z"></path></svg>
              </div>
              <span class="text-xs font-semibold text-orange-600 uppercase tracking-widest">Sector 03</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-900 mb-2">Oil & Gas Facilities</h3>
            <div class="w-10 h-0.5 bg-orange-500 mb-3"></div>
            <p class="text-zinc-500 text-sm leading-relaxed">Pipe racks, equipment platforms, skid structures, and refinery frameworks built to AS/NZS standards for high-demand environments.</p>
          </div>
        </div>

        <!-- Industry 4 — image right -->
        <div class="flex flex-col md:flex-row-reverse overflow-hidden rounded-2xl border border-orange-100 shadow-sm shadow-orange-200/30 hover:shadow-md hover:shadow-orange-200/40 hover:border-orange-300 transition-all duration-300 group h-auto md:h-60">
          <div class="w-full md:w-2/5 h-52 md:h-full relative overflow-hidden shrink-0">
            <Image src={ind4Img} alt="Stadiums" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-zinc-950/25 group-hover:bg-zinc-950/15 transition-colors duration-300"></div>
          </div>
          <div class="flex-1 flex flex-col justify-center px-8 py-7 bg-orange-50/40">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-orange-50 text-orange-700 border border-orange-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.382-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
              </div>
              <span class="text-xs font-semibold text-orange-600 uppercase tracking-widest">Sector 04</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-900 mb-2">Stadiums & Public Venues</h3>
            <div class="w-10 h-0.5 bg-orange-500 mb-3"></div>
            <p class="text-zinc-500 text-sm leading-relaxed">Long-span roof trusses, cantilevered grandstands, and complex architectural steel for major sport and entertainment venues.</p>
          </div>
        </div>

        <!-- Industry 5 — image left -->
        <div class="flex flex-col md:flex-row overflow-hidden rounded-2xl border border-orange-100 shadow-sm shadow-orange-200/30 hover:shadow-md hover:shadow-orange-200/40 hover:border-orange-300 transition-all duration-300 group h-auto md:h-60">
          <div class="w-full md:w-2/5 h-52 md:h-full relative overflow-hidden shrink-0">
            <Image src={ind5Img} alt="Warehouses & Logistics" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-zinc-950/25 group-hover:bg-zinc-950/15 transition-colors duration-300"></div>
          </div>
          <div class="flex-1 flex flex-col justify-center px-8 py-7 bg-orange-50/40">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-orange-50 text-orange-700 border border-orange-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
              </div>
              <span class="text-xs font-semibold text-orange-600 uppercase tracking-widest">Sector 05</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-900 mb-2">Warehouses & Logistics</h3>
            <div class="w-10 h-0.5 bg-orange-500 mb-3"></div>
            <p class="text-zinc-500 text-sm leading-relaxed">Clear-span portal frames and mezzanine structures optimised for rapid fabrication, efficient erection, and large-footprint logistics operations.</p>
          </div>
        </div>

        <!-- Industry 6 — image right -->
        <div class="flex flex-col md:flex-row-reverse overflow-hidden rounded-2xl border border-orange-100 shadow-sm shadow-orange-200/30 hover:shadow-md hover:shadow-orange-200/40 hover:border-orange-300 transition-all duration-300 group h-auto md:h-60">
          <div class="w-full md:w-2/5 h-52 md:h-full relative overflow-hidden shrink-0">
            <Image src={ind6Img} alt="Miscellaneous & Architectural Steel" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-zinc-950/25 group-hover:bg-zinc-950/15 transition-colors duration-300"></div>
          </div>
          <div class="flex-1 flex flex-col justify-center px-8 py-7 bg-orange-50/40">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-orange-50 text-orange-700 border border-orange-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path></svg>
              </div>
              <span class="text-xs font-semibold text-orange-600 uppercase tracking-widest">Sector 06</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-900 mb-2">Miscellaneous & Architectural Steel</h3>
            <div class="w-10 h-0.5 bg-orange-500 mb-3"></div>
            <p class="text-zinc-500 text-sm leading-relaxed">Staircases, handrails, canopies, facades, and bespoke architectural metalwork where precision detailing meets design intent.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Strategic Advantage Section -->
  <section class="py-24 bg-zinc-900 text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-orange-600/6 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-zinc-800/40 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <div class="max-w-2xl mx-auto text-center mb-14">
        <p class="text-xs font-semibold text-orange-500 uppercase tracking-widest mb-4">Why Work With Us</p>
        <h2 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight">Strategic Advantage</h2>
        <p class="text-zinc-400 text-lg leading-relaxed">
          Our operating model delivers measurable advantages across every engagement — from day one through project closeout.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 max-w-5xl mx-auto">

        <!-- Card 01 -->
        <div class="bg-zinc-800/60 border border-zinc-700/50 rounded-xl p-6 flex flex-col items-center text-center gap-4 hover:border-orange-500/50 hover:bg-zinc-800 transition-all duration-200 group cursor-default">
          <div class="w-12 h-12 bg-orange-500/15 text-orange-400 border border-orange-500/20 rounded-xl flex items-center justify-center group-hover:bg-orange-500/25 transition-colors shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div class="w-6 h-0.5 bg-orange-500/40 group-hover:bg-orange-500 transition-colors"></div>
          <h4 class="font-semibold text-white text-sm leading-snug">Extended Work Hours</h4>
        </div>

        <!-- Card 02 -->
        <div class="bg-zinc-800/60 border border-zinc-700/50 rounded-xl p-6 flex flex-col items-center text-center gap-4 hover:border-orange-500/50 hover:bg-zinc-800 transition-all duration-200 group cursor-default">
          <div class="w-12 h-12 bg-orange-500/15 text-orange-400 border border-orange-500/20 rounded-xl flex items-center justify-center group-hover:bg-orange-500/25 transition-colors shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <div class="w-6 h-0.5 bg-orange-500/40 group-hover:bg-orange-500 transition-colors"></div>
