---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { Image } from 'astro:assets';
import heroBgImg from '@assets/images/PHOTO 13.jpg';
import lifecycleImg from '@assets/images/lifecycle.webp';
import ind1Img from '@assets/images/industrial.webp';
import ind2Img from '@assets/images/commercial_buildings.webp';
import ind3Img from '@assets/images/oil_and_gas.webp';
import ind4Img from '@assets/images/stadium.webp';
import ind5Img from '@assets/images/warehouse.webp';
import ind6Img from '@assets/images/miscellaneous_and_architectural_steel.webp';
---

<BaseLayout title="Steel Detailing Services | Precision 3D Modeling" description="Expert structural steel detailing, 3D modeling, and fabrication drawings using Tekla Structures. Serving Australian steel fabricators, EPC contractors, and structural consultants.">

  <!-- Hero Section -->
  <section class="relative min-h-[85vh] bg-emerald-50 border-b border-emerald-200 overflow-hidden flex items-center">
    <!-- Full-bleed background image -->
    <div class="absolute inset-0">
      <Image
        src={heroBgImg}
        alt="Engineering Confidence into Every Steel Structure"
        class="w-full h-full object-cover object-center"
        width={1920}
        height={1080}
        decoding="async"
        fetchpriority="high"
      />
      <!-- Gradient: dense zinc-50 on the left fading to near-transparent on the right -->
      <div class="absolute inset-0 bg-linear-to-r from-emerald-50 from-30% via-emerald-50/70 via-55% to-emerald-50/5"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 container mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 py-24 animate-fadeInUp">
      <div class="max-w-2xl">

        <div class="inline-flex items-center px-4 py-2 border border-emerald-500/70 bg-white/70 text-emerald-700 text-sm font-semibold rounded-sm mb-8 backdrop-blur-sm">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          Duinz Engineering Services
        </div>

        <h1 class="text-5xl md:text-6xl font-bold text-zinc-900 leading-tight mb-6">
          Engineering Confidence into Every
          <span class="block text-transparent bg-clip-text bg-linear-to-r from-emerald-600 to-emerald-500 mt-1">
            Steel Structure
          </span>
        </h1>

        <p class="text-lg text-zinc-700 max-w-lg leading-relaxed mb-8">
          Specialist structural steel detailing and BIM modeling delivering technically robust, fabrication-ready solutions. Operating as an extended engineering partner to steel fabricators, EPC contractors, and structural consultants.
        </p>

        <a
          href="/contact#contact-form-container"
          class="inline-flex items-center px-8 py-3.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 mb-12"
        >
          Work With Us
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>

        <!-- Metrics -->
        <div class="pt-8 border-t border-emerald-200/80">
          <div class="grid grid-cols-3 gap-x-8 gap-y-10">
            <div class="border-l-[3px] border-emerald-500 pl-4 group">
              <div class="text-3xl font-bold text-zinc-900 tracking-tight">40+</div>
              <div class="text-sm text-zinc-500 mt-1 group-hover:text-emerald-600 transition-colors leading-snug">Structural Engineers</div>
            </div>
            <div class="border-l-[3px] border-emerald-500 pl-4 group">
              <div class="text-3xl font-bold text-zinc-900 tracking-tight">12</div>
              <div class="text-sm text-zinc-500 mt-1 group-hover:text-emerald-600 transition-colors leading-snug">Tekla Licenses</div>
            </div>
            <div class="border-l-[3px] border-emerald-500 pl-4 group">
              <div class="text-3xl font-bold text-zinc-900 tracking-tight">QA</div>
              <div class="text-sm text-zinc-500 mt-1 group-hover:text-emerald-600 transition-colors leading-snug">Multi-Level Quality Assurance</div>
            </div>
            <div class="border-l-[3px] border-emerald-500 pl-4 group">
              <div class="text-3xl font-bold text-zinc-900 tracking-tight">Teams</div>
              <div class="text-sm text-zinc-500 mt-1 group-hover:text-emerald-600 transition-colors leading-snug">Scalable Project Integration</div>
            </div>
            <div class="border-l-[3px] border-emerald-500 pl-4 group">
              <div class="text-3xl font-bold text-zinc-900 tracking-tight">Secure</div>
              <div class="text-sm text-zinc-500 mt-1 group-hover:text-emerald-600 transition-colors leading-snug">Digital Collaboration</div>
            </div>
            <div class="border-l-[3px] border-emerald-500 pl-4 group">
              <div class="text-3xl font-bold text-zinc-900 tracking-tight">24/7</div>
              <div class="text-sm text-zinc-500 mt-1 group-hover:text-emerald-600 transition-colors leading-snug">Operational Infrastructure</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- Workflow Section -->
  <section class="py-24 bg-zinc-50 text-zinc-900 border-t border-zinc-200">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">

        <!-- Content — left -->
        <div class="lg:w-1/2 flex flex-col justify-center">
          <div class="bg-white rounded-xl border border-zinc-200/80 shadow-sm p-8 lg:p-10">
            <div class="border-l-4 border-emerald-500 pl-6">
              <h2 class="text-3xl md:text-4xl font-bold leading-tight text-zinc-900">Our Role in the Construction Lifecycle</h2>
              <p class="text-zinc-600 text-lg mt-4">We bridge the gap between structural design and physical implementation. By serving as an offshore detailing partner, we provide top-tier CAD/BIM solutions that keep projects on schedule.</p>

              <ul class="space-y-4 pt-6">
                <li class="flex items-start">
                  <div class="shrink-0 w-8 h-8 rounded-md bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold mr-4 border border-emerald-200">1</div>
                  <div>
                    <h4 class="font-bold text-lg text-zinc-900">Precise Detailing</h4>
                    <p class="text-zinc-500 text-sm">High-precision steel models integrated with fabrication-ready CNC and material outputs.</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <div class="shrink-0 w-8 h-8 rounded-md bg-zinc-900 text-emerald-300 flex items-center justify-center font-bold mr-4 border border-zinc-700">2</div>
                  <div>
                    <h4 class="font-bold text-lg text-zinc-900">Fabrication & Assembly</h4>
                    <p class="text-zinc-500 text-sm">We deliver accurate shop drawings and erection plans to ensure smooth site execution.</p>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Image — right -->
        <div class="lg:w-1/2 relative w-full h-[400px] lg:h-[500px]">
          <div class="absolute inset-0 bg-linear-to-tr from-emerald-600/8 to-zinc-900/8 rounded-3xl blur-3xl mix-blend-multiply opacity-50"></div>
          <div class="relative w-full h-full">
            <div class="absolute inset-0 border-2 border-emerald-700/30 rounded-xl shadow-2xl overflow-hidden group">
              <Image
                src={lifecycleImg}
                alt="Steel construction lifecycle"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90 group-hover:opacity-100"
              />
            </div>
            <div class="absolute -bottom-3 -right-3 w-full h-full border-2 border-emerald-600/20 rounded-xl -z-10 pointer-events-none"></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Industries Served Section -->
  <section class="py-24 bg-white border-t border-zinc-200">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-zinc-900 mb-6 tracking-tight">Industries We Serve</h2>
        <p class="text-lg text-zinc-600 leading-relaxed">
          Delivering specialized structural detailing across a diverse range of sectors, ensuring compliance with industry-specific standards and operational requirements.
        </p>
      </div>

      <div class="space-y-5 max-w-6xl mx-auto">

        <!-- Industry 1 — image left -->
        <div class="flex flex-col md:flex-row overflow-hidden rounded-2xl border border-zinc-200 shadow-sm hover:shadow-lg hover:border-emerald-300/60 transition-all duration-300 group h-auto md:h-60">
          <div class="w-full md:w-2/5 h-52 md:h-full relative overflow-hidden shrink-0">
            <Image src={ind1Img} alt="Industrial Structures" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-zinc-950/25 group-hover:bg-zinc-950/15 transition-colors duration-300"></div>
          </div>
          <div class="flex-1 flex flex-col justify-center px-8 py-7 bg-white">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
              </div>
              <span class="text-xs font-semibold text-emerald-600 uppercase tracking-widest">Sector 01</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-900 mb-2">Industrial Structures</h3>
            <div class="w-10 h-0.5 bg-emerald-500 mb-3"></div>
            <p class="text-zinc-500 text-sm leading-relaxed">Heavy-duty structural frameworks for manufacturing plants, process facilities, and industrial complexes built to exacting tolerances.</p>
          </div>
        </div>

        <!-- Industry 2 — image right -->
        <div class="flex flex-col md:flex-row-reverse overflow-hidden rounded-2xl border border-zinc-200 shadow-sm hover:shadow-lg hover:border-emerald-300/60 transition-all duration-300 group h-auto md:h-60">
          <div class="w-full md:w-2/5 h-52 md:h-full relative overflow-hidden shrink-0">
            <Image src={ind2Img} alt="Commercial Buildings" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-zinc-950/25 group-hover:bg-zinc-950/15 transition-colors duration-300"></div>
          </div>
          <div class="flex-1 flex flex-col justify-center px-8 py-7 bg-zinc-50">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"></path></svg>
              </div>
              <span class="text-xs font-semibold text-emerald-600 uppercase tracking-widest">Sector 02</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-900 mb-2">Commercial Buildings</h3>
            <div class="w-10 h-0.5 bg-emerald-500 mb-3"></div>
            <p class="text-zinc-500 text-sm leading-relaxed">Multi-storey office towers, retail centres, and mixed-use developments with complex steel framing and facade integration.</p>
          </div>
        </div>

        <!-- Industry 3 — image left -->
        <div class="flex flex-col md:flex-row overflow-hidden rounded-2xl border border-zinc-200 shadow-sm hover:shadow-lg hover:border-emerald-300/60 transition-all duration-300 group h-auto md:h-60">
          <div class="w-full md:w-2/5 h-52 md:h-full relative overflow-hidden shrink-0">
            <Image src={ind3Img} alt="Oil & Gas Facilities" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-zinc-950/25 group-hover:bg-zinc-950/15 transition-colors duration-300"></div>
          </div>
          <div class="flex-1 flex flex-col justify-center px-8 py-7 bg-white">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.99 7.99 0 0120 13a7.98 7.98 0 01-2.343 5.657z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14l.879 2.121z"></path></svg>
              </div>
              <span class="text-xs font-semibold text-emerald-600 uppercase tracking-widest">Sector 03</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-900 mb-2">Oil & Gas Facilities</h3>
            <div class="w-10 h-0.5 bg-emerald-500 mb-3"></div>
            <p class="text-zinc-500 text-sm leading-relaxed">Pipe racks, equipment platforms, skid structures, and refinery frameworks built to AS/NZS standards for high-demand environments.</p>
          </div>
        </div>

        <!-- Industry 4 — image right -->
        <div class="flex flex-col md:flex-row-reverse overflow-hidden rounded-2xl border border-zinc-200 shadow-sm hover:shadow-lg hover:border-emerald-300/60 transition-all duration-300 group h-auto md:h-60">
          <div class="w-full md:w-2/5 h-52 md:h-full relative overflow-hidden shrink-0">
            <Image src={ind4Img} alt="Stadiums" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-zinc-950/25 group-hover:bg-zinc-950/15 transition-colors duration-300"></div>
          </div>
          <div class="flex-1 flex flex-col justify-center px-8 py-7 bg-zinc-50">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.382-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
              </div>
              <span class="text-xs font-semibold text-emerald-600 uppercase tracking-widest">Sector 04</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-900 mb-2">Stadiums & Public Venues</h3>
            <div class="w-10 h-0.5 bg-emerald-500 mb-3"></div>
            <p class="text-zinc-500 text-sm leading-relaxed">Long-span roof trusses, cantilevered grandstands, and complex architectural steel for major sport and entertainment venues.</p>
          </div>
        </div>

        <!-- Industry 5 — image left -->
        <div class="flex flex-col md:flex-row overflow-hidden rounded-2xl border border-zinc-200 shadow-sm hover:shadow-lg hover:border-emerald-300/60 transition-all duration-300 group h-auto md:h-60">
          <div class="w-full md:w-2/5 h-52 md:h-full relative overflow-hidden shrink-0">
            <Image src={ind5Img} alt="Warehouses & Logistics" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-zinc-950/25 group-hover:bg-zinc-950/15 transition-colors duration-300"></div>
          </div>
          <div class="flex-1 flex flex-col justify-center px-8 py-7 bg-white">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
              </div>
              <span class="text-xs font-semibold text-emerald-600 uppercase tracking-widest">Sector 05</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-900 mb-2">Warehouses & Logistics</h3>
            <div class="w-10 h-0.5 bg-emerald-500 mb-3"></div>
            <p class="text-zinc-500 text-sm leading-relaxed">Clear-span portal frames and mezzanine structures optimised for rapid fabrication, efficient erection, and large-footprint logistics operations.</p>
          </div>
        </div>

        <!-- Industry 6 — image right -->
        <div class="flex flex-col md:flex-row-reverse overflow-hidden rounded-2xl border border-zinc-200 shadow-sm hover:shadow-lg hover:border-emerald-300/60 transition-all duration-300 group h-auto md:h-60">
          <div class="w-full md:w-2/5 h-52 md:h-full relative overflow-hidden shrink-0">
            <Image src={ind6Img} alt="Miscellaneous & Architectural Steel" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-zinc-950/25 group-hover:bg-zinc-950/15 transition-colors duration-300"></div>
          </div>
          <div class="flex-1 flex flex-col justify-center px-8 py-7 bg-zinc-50">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path></svg>
              </div>
              <span class="text-xs font-semibold text-emerald-600 uppercase tracking-widest">Sector 06</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-900 mb-2">Miscellaneous & Architectural Steel</h3>
            <div class="w-10 h-0.5 bg-emerald-500 mb-3"></div>
            <p class="text-zinc-500 text-sm leading-relaxed">Staircases, handrails, canopies, facades, and bespoke architectural metalwork where precision detailing meets design intent.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Strategic Advantage Section -->
  <section class="py-24 bg-zinc-900 text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-emerald-600/6 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-zinc-800/40 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <div class="max-w-4xl mx-auto mb-14">
        <p class="text-xs font-semibold text-emerald-500 uppercase tracking-widest mb-4">Why Work With Us</p>
        <h2 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight">Strategic Advantage</h2>
        <p class="text-zinc-400 text-lg max-w-2xl leading-relaxed">
          Our operating model delivers measurable advantages across every engagement — from day one through project closeout.
        </p>
      </div>

      <div class="max-w-4xl mx-auto divide-y divide-zinc-800/80">

        <!-- Advantage 01 -->
        <div class="flex items-start gap-6 sm:gap-10 py-8 group hover:bg-zinc-900/50 -mx-4 px-4 transition-colors duration-200 rounded-lg cursor-default">
          <div class="w-10 h-10 sm:w-11 sm:h-11 bg-emerald-500/15 text-emerald-400 border border-emerald-500/25 rounded-lg flex items-center justify-center shrink-0 group-hover:bg-emerald-500/25 transition-colors duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div class="flex-1 pt-0.5">
            <h4 class="font-bold text-base sm:text-lg text-white mb-1.5">Extended Work Hours</h4>
            <p class="text-zinc-400 text-sm leading-relaxed">Our team operates on IST, providing meaningful time-zone overlap with Australian business hours — enabling real-time collaboration, same-day responses, and shorter review cycles.</p>
          </div>
        </div>

        <!-- Advantage 02 -->
        <div class="flex items-start gap-6 sm:gap-10 py-8 group hover:bg-zinc-900/50 -mx-4 px-4 transition-colors duration-200 rounded-lg cursor-default">
          <div class="w-10 h-10 sm:w-11 sm:h-11 bg-emerald-500/15 text-emerald-400 border border-emerald-500/25 rounded-lg flex items-center justify-center shrink-0 group-hover:bg-emerald-500/25 transition-colors duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <div class="flex-1 pt-0.5">
            <h4 class="font-bold text-base sm:text-lg text-white mb-1.5">Faster Turnaround</h4>
            <p class="text-zinc-400 text-sm leading-relaxed">Structured detailing workflows and dedicated project teams consistently deliver shop drawings and 3D models within agreed 24–48 hour review cycles, keeping fabrication schedules on track.</p>
          </div>
        </div>

        <!-- Advantage 03 -->
        <div class="flex items-start gap-6 sm:gap-10 py-8 group hover:bg-zinc-900/50 -mx-4 px-4 transition-colors duration-200 rounded-lg cursor-default">
          <div class="w-10 h-10 sm:w-11 sm:h-11 bg-emerald-500/15 text-emerald-400 border border-emerald-500/25 rounded-lg flex items-center justify-center shrink-0 group-hover:bg-emerald-500/25 transition-colors duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
          </div>
