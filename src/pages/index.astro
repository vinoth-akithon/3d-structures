---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { Image } from 'astro:assets';
import heroBgImg from '@assets/images/PHOTO 13.jpg';
import ind1Img from '@assets/images/1.jpg';
import ind2Img from '@assets/images/2.jpg';
import ind3Img from '@assets/images/3.jpg';
import ind4Img from '@assets/images/4.jpg';
import ind5Img from '@assets/images/PHOTO 35.jpg';
import ind6Img from '@assets/images/PHOTO 36.jpg';
/* 
import PremiumHero from '../components/home/PremiumHero.astro';
import ServiceHighlights from '../components/home/ServiceHighlights.astro';
import ImageGrid from '../components/home/ImageGrid.astro';
import StatsShowcase from '../components/home/StatsShowcase.astro';
import IndustriesServed from '../components/home/IndustriesServed.astro';
import TechnologyInnovation from '../components/home/TechnologyInnovation.astro';
import ProcessWorkflow from '../components/home/ProcessWorkflow.astro';
import Testimonials from '../components/home/Testimonials.astro';
import PremiumCTA from '../components/home/PremiumCTA.astro';
*/
---

<BaseLayout title="Steel Detailing Services | Precision 3D Modeling" description="Expert structural steel detailing, 3D modeling, and fabrication drawings using Tekla Structures.">
  <!-- 
  <PremiumHero />
  <ServiceHighlights />
  <ImageGrid />
  <IndustriesServed />
  <TechnologyInnovation />
  <ProcessWorkflow />
  <StatsShowcase />
  <Testimonials />
  <PremiumCTA />
  -->

  <!-- Custom Steel Detailing Overview Home Page -->
  
  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex items-center overflow-hidden bg-slate-900">
    <div class="absolute inset-0">
      <Image 
        src={heroBgImg}
        alt="Engineering Confidence into Every Steel Structure"
        class="w-full h-full object-cover"
        width={1920}
        height={1080}
        decoding="async"
        fetchpriority="high"
      />
      <!-- Reduced overlay opacity to make image brighter -->
      <div class="absolute inset-0 bg-linear-to-r from-slate-950/85 via-slate-900/70 to-slate-800/60"></div>
    </div>

    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8 py-24">
      <div class="max-w-4xl space-y-8 animate-fadeInUp">
        <div class="inline-flex items-center px-4 py-2 bg-linear-to-r from-blue-600 to-teal-600 text-white text-sm font-semibold rounded-full shadow-lg">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          Duinz Engineering Services Pvt Ltd
        </div>
        
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-tight">
          Engineering Confidence into Every
          <span class="block text-transparent bg-clip-text bg-linear-to-r from-blue-400 via-teal-400 to-blue-400 mt-2">
            Steel Structure
          </span>
        </h1>
        
        <p class="text-xl md:text-2xl text-slate-300 max-w-2xl leading-relaxed">
          Specialist structural steel detailing and BIM modeling delivering technically robust, fabrication-ready solutions. Operating as an extended engineering partner to steel fabricators, EPC contractors, and structural consultants.
        </p>
        
        <div class="grid grid-cols-2 md:grid-cols-3 gap-y-8 gap-x-6 pt-8 pb-4 border-t border-white/20">
          <div class="group">
            <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200 mb-1">40+</div>
            <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Structural Engineers</div>
          </div>
          <div class="group">
            <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200 mb-1">12</div>
            <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Tekla Licenses</div>
          </div>
          <div class="group">
            <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200 mb-1">QA</div>
            <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Multi-Level Quality Assurance</div>
          </div>
          <div class="group">
            <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200 mb-1">Teams</div>
            <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Scalable Project Integration</div>
          </div>
          <div class="group">
            <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200 mb-1">Secure</div>
            <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Digital Collaboration</div>
          </div>
          <div class="group">
            <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200 mb-1">24/7</div>
            <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Operational Infrastructure</div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Workflow Section -->
  <section class="py-24 bg-white text-slate-900 border-t border-slate-100">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-[1.5] lg:flex-row items-center gap-16">
        <div class="lg:w-1/2 space-y-6">
          <h2 class="text-3xl md:text-4xl font-bold leading-tight">Our Role in the Construction Lifecycle</h2>
          <p class="text-slate-600 text-lg">We bridge the gap between structural design and physical implementation. By serving as an offshore detailing partner, we provide top-tier CAD/BIM solutions that keep projects on schedule.</p>
          
          <ul class="space-y-4 pt-4">
            <li class="flex items-start">
              <div class="shrink-0 w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold mr-4 outline outline-2 outline-blue-100">1</div>
              <div>
                <h4 class="font-bold text-lg">Precise Detailing</h4>
                <p class="text-slate-500 text-sm">High-precision steel models integrated with fabrication-ready CNC and material outputs.</p>
              </div>
            </li>
            <li class="flex items-start">
              <div class="shrink-0 w-8 h-8 rounded-full bg-teal-50 text-teal-600 flex items-center justify-center font-bold mr-4 outline outline-2 outline-teal-100">2</div>
              <div>
                <h4 class="font-bold text-lg">Fabrication & Assembly</h4>
                <p class="text-slate-500 text-sm">We deliver accurate shop drawings and erection plans to ensure smooth site execution.</p>
              </div>
            </li>
          </ul>
        </div>
        
        <div class="lg:w-1/2 relative w-full h-[400px] lg:h-[500px]">
          <div class="absolute inset-0 bg-linear-to-tl from-blue-600/10 to-teal-600/10 rounded-3xl blur-3xl mix-blend-multiply opacity-50"></div>
          <div class="absolute inset-0 bg-slate-50/50 backdrop-blur-md rounded-3xl border border-slate-200 shadow-2xl overflow-hidden group">
             <!-- Real image representation -->
             <Image 
                src={import('@assets/images/PHOTO 10.jpg')}
                alt="Steel construction lifecycle"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90 group-hover:opacity-100"
             />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries Served Section -->
  <section class="py-24 bg-slate-50 relative border-t border-slate-100 overflow-hidden">
    <div class="absolute top-0 right-0 w-full h-full overflow-hidden pointer-events-none opacity-30">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-blue-100 rounded-full mix-blend-multiply blur-3xl"></div>
      <div class="absolute top-40 -left-20 w-72 h-72 bg-teal-100 rounded-full mix-blend-multiply blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6 tracking-tight">Industries We Serve</h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          Delivering specialized structural detailing across a diverse range of sectors, ensuring compliance with industry-specific standards and operational requirements.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <!-- Industry 1 -->
        <div class="relative rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group overflow-hidden h-64 flex flex-col justify-end p-6">
          <Image src={ind1Img} alt="Industrial Structures" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
          
          <div class="relative z-10 flex items-center">
            <div class="w-10 h-10 rounded-full bg-blue-500/20 text-blue-300 backdrop-blur-xs flex items-center justify-center mr-4 border border-blue-400/30 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-white tracking-wide">Industrial Structures</h3>
          </div>
        </div>

        <!-- Industry 2 -->
        <div class="relative rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group overflow-hidden h-64 flex flex-col justify-end p-6">
          <Image src={ind2Img} alt="Commercial Buildings" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
          
          <div class="relative z-10 flex items-center">
            <div class="w-10 h-10 rounded-full bg-blue-500/20 text-blue-300 backdrop-blur-xs flex items-center justify-center mr-4 border border-blue-400/30 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-white tracking-wide">Commercial Buildings</h3>
          </div>
        </div>

        <!-- Industry 3 -->
        <div class="relative rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group overflow-hidden h-64 flex flex-col justify-end p-6">
          <Image src={ind3Img} alt="Oil & Gas Facilities" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
          
          <div class="relative z-10 flex items-center">
            <div class="w-10 h-10 rounded-full bg-blue-500/20 text-blue-300 backdrop-blur-xs flex items-center justify-center mr-4 border border-blue-400/30 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-white tracking-wide">Oil & Gas Facilities</h3>
          </div>
        </div>

        <!-- Industry 4 -->
        <div class="relative rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group overflow-hidden h-64 flex flex-col justify-end p-6">
          <Image src={ind4Img} alt="Power & Energy Projects" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
          
          <div class="relative z-10 flex items-center">
            <div class="w-10 h-10 rounded-full bg-blue-500/20 text-blue-300 backdrop-blur-xs flex items-center justify-center mr-4 border border-blue-400/30 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-white tracking-wide">Power & Energy Projects</h3>
          </div>
        </div>

        <!-- Industry 5 -->
        <div class="relative rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group overflow-hidden h-64 flex flex-col justify-end p-6">
          <Image src={ind5Img} alt="Warehouses & Logistics" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
          
          <div class="relative z-10 flex items-center">
            <div class="w-10 h-10 rounded-full bg-blue-500/20 text-blue-300 backdrop-blur-xs flex items-center justify-center mr-4 border border-blue-400/30 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-white tracking-wide">Warehouses & Logistics</h3>
          </div>
        </div>

        <!-- Industry 6 -->
        <div class="relative rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group overflow-hidden h-64 flex flex-col justify-end p-6">
          <Image src={ind6Img} alt="Miscellaneous & Architectural Steel" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
          
          <div class="relative z-10 flex items-center">
            <div class="w-10 h-10 rounded-full bg-blue-500/20 text-blue-300 backdrop-blur-xs flex items-center justify-center mr-4 border border-blue-400/30 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-white tracking-wide">Miscellaneous & Architectural Steel</h3>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Strategic Advantage Section -->
  <section class="py-24 bg-slate-900 text-white relative overflow-hidden">
    <!-- Abstract Glows -->
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-teal-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold mb-6 bg-clip-text text-transparent bg-linear-to-r from-white via-slate-200 to-slate-400">Strategic Advantage</h2>
        <p class="text-xl text-slate-300 leading-relaxed font-light mb-4">
          Our operating model provides extended working-hour advantage, faster turnaround cycles, structured communication, scalable manpower allocation, and cost-efficient project execution.
        </p>
        <p class="text-lg text-teal-400 font-medium">
          We focus on long-term partnerships built on transparency, accountability, and technical reliability.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        <!-- Advantage 1 -->
        <div class="bg-slate-800/50 backdrop-blur-md p-6 rounded-2xl border border-slate-700 hover:border-blue-500/50 hover:-translate-y-1 transition-all group text-center flex flex-col items-center justify-center">
          <div class="w-14 h-14 bg-blue-500/20 text-blue-400 border border-blue-500/30 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
             <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h4 class="font-bold text-slate-100">Extended Work Hours</h4>
        </div>
        
        <!-- Advantage 2 -->
        <div class="bg-slate-800/50 backdrop-blur-md p-6 rounded-2xl border border-slate-700 hover:border-teal-500/50 hover:-translate-y-1 transition-all group text-center flex flex-col items-center justify-center">
          <div class="w-14 h-14 bg-teal-500/20 text-teal-400 border border-teal-500/30 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
             <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h4 class="font-bold text-slate-100">Faster Turnaround</h4>
        </div>

        <!-- Advantage 3 -->
        <div class="bg-slate-800/50 backdrop-blur-md p-6 rounded-2xl border border-slate-700 hover:border-indigo-500/50 hover:-translate-y-1 transition-all group text-center flex flex-col items-center justify-center">
          <div class="w-14 h-14 bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
             <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
          </div>
          <h4 class="font-bold text-slate-100">Structured Communication</h4>
        </div>

        <!-- Advantage 4 -->
        <div class="bg-slate-800/50 backdrop-blur-md p-6 rounded-2xl border border-slate-700 hover:border-blue-500/50 hover:-translate-y-1 transition-all group text-center flex flex-col items-center justify-center">
          <div class="w-14 h-14 bg-blue-500/20 text-blue-400 border border-blue-500/30 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
             <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <h4 class="font-bold text-slate-100">Scalable Manpower</h4>
        </div>

        <!-- Advantage 5 -->
        <div class="bg-slate-800/50 backdrop-blur-md p-6 rounded-2xl border border-slate-700 hover:border-teal-500/50 hover:-translate-y-1 transition-all group text-center flex flex-col items-center justify-center">
          <div class="w-14 h-14 bg-teal-500/20 text-teal-400 border border-teal-500/30 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
             <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h4 class="font-bold text-slate-100">Cost-Efficient Execution</h4>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
