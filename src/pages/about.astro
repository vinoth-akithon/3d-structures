---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import ctaBgImg from '@assets/images/PHOTO 35.jpg';
---

<BaseLayout title="About Us | 3D Structure">
  <!-- Hero Section -->
  <section class="relative h-[70vh] min-h-[500px] flex items-center overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0">
      <Image 
        src={ctaBgImg}
        alt="Steel detailing office operations"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-linear-to-r from-slate-900/95 via-slate-900/80 to-slate-900/50"></div>
    </div>

    <!-- Content -->
    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center px-4 py-2 mb-6 bg-linear-to-r from-blue-600 to-teal-600 text-white text-sm font-semibold rounded-full shadow-lg">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Who We Are
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
          A Culture of <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 via-teal-400 to-blue-400">
            Technical Discipline
          </span>
        </h1>
        
        <p class="text-xl md:text-2xl text-slate-200 mb-8 max-w-3xl mx-auto leading-relaxed">
          3D Structure was established with a singular objective — to deliver uncompromising quality in structural steel detailing.
        </p>
      </div>
    </div>
  </section>
  
  <section class="py-24 bg-slate-50 relative">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-16 items-start">
        
        <!-- Left Column: Operations -->
        <div class="lg:w-1/2 space-y-6">
          <div class="inline-flex items-center px-4 py-2 bg-blue-100 text-blue-800 text-sm font-semibold rounded-full">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Global Reach
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 leading-tight">
            International Support from Strategic Hubs
          </h2>
          <p class="text-lg text-slate-600 leading-relaxed">
            Our operations are based in <span class="font-semibold text-slate-800">Tiruchirappalli, Pattukkottai, and Kochi, India</span>. From these locations, we support international steel projects through structured engineering workflows and disciplined execution processes.
          </p>
          <p class="text-lg text-slate-600 leading-relaxed">
            Our teams combine experienced senior checkers with highly skilled modeling engineers to ensure both technical accuracy and efficient turnaround.
          </p>
        </div>

        <!-- Right Column: Approach -->
        <div class="lg:w-1/2 bg-white rounded-2xl p-8 md:p-12 shadow-xl border border-slate-100">
           <h3 class="text-2xl font-bold text-slate-900 mb-8 border-b border-slate-100 pb-4">Our Approach</h3>
           <ul class="space-y-6">
             <li class="flex items-start group">
               <div class="shrink-0 w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mr-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                 <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
               </div>
               <div>
                 <h4 class="font-semibold text-lg text-slate-900">Defined responsibility allocation</h4>
                 <p class="text-slate-500 text-sm mt-1">Clear ownership at every stage of the detailing process.</p>
               </div>
             </li>
             <li class="flex items-start group">
               <div class="shrink-0 w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mr-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                 <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
               </div>
               <div>
                 <h4 class="font-semibold text-lg text-slate-900">Clear internal communication protocols</h4>
                 <p class="text-slate-500 text-sm mt-1">Seamless collaboration between modelers and checkers.</p>
               </div>
             </li>
             <li class="flex items-start group">
               <div class="shrink-0 w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mr-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                 <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
               </div>
               <div>
                 <h4 class="font-semibold text-lg text-slate-900">Realistic scheduling</h4>
                 <p class="text-slate-500 text-sm mt-1">Dependable timelines that keep fabrication on track.</p>
               </div>
             </li>
             <li class="flex items-start group">
               <div class="shrink-0 w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mr-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                 <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
               </div>
               <div>
                 <h4 class="font-semibold text-lg text-slate-900">Structured quality control systems</h4>
                 <p class="text-slate-500 text-sm mt-1">Multi-level QA to guarantee error-free deliverables.</p>
               </div>
             </li>
             <li class="flex items-start group">
               <div class="shrink-0 w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mr-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                 <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
               </div>
               <div>
                 <h4 class="font-semibold text-lg text-slate-900">Fabricator-specific standard compliance</h4>
                 <p class="text-slate-500 text-sm mt-1">Customized drawings that match exact shop floor needs.</p>
               </div>
             </li>
           </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality Assurance Section -->
  <section class="py-24 bg-slate-900 text-white relative overflow-hidden border-t border-slate-800">
    <!-- Abstract Background Gradients -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
      <div class="absolute -top-1/2 -right-1/4 w-[800px] h-[800px] rounded-full bg-linear-to-b from-blue-600/10 to-transparent blur-3xl"></div>
      <div class="absolute -bottom-1/2 -left-1/4 w-[600px] h-[600px] rounded-full bg-linear-to-t from-teal-600/10 to-transparent blur-3xl"></div>
    </div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold mb-6 bg-clip-text text-transparent bg-linear-to-r from-white via-slate-200 to-slate-400">Structured Multi-Level Review System</h2>
        <p class="text-xl text-blue-200 leading-relaxed italic opacity-90">
          "Quality is embedded within our workflow — not inspected at the end."
        </p>
      </div>

      <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-12 bg-slate-800/50 backdrop-blur-md rounded-3xl p-8 md:p-12 shadow-2xl border border-slate-700">
        <div class="md:w-1/2">
          <ul class="space-y-6">
            <li class="flex items-center group">
              <div class="shrink-0 w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center mr-5 border border-blue-500/30 group-hover:bg-blue-500/40 transition-colors">
                <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-slate-200 font-medium text-lg tracking-wide">Dedicated checking teams</span>
            </li>
            <li class="flex items-center group">
              <div class="shrink-0 w-10 h-10 rounded-full bg-teal-500/20 flex items-center justify-center mr-5 border border-teal-500/30 group-hover:bg-teal-500/40 transition-colors">
                <svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-slate-200 font-medium text-lg tracking-wide">Multi-stage drawing reviews</span>
            </li>
            <li class="flex items-center group">
              <div class="shrink-0 w-10 h-10 rounded-full bg-indigo-500/20 flex items-center justify-center mr-5 border border-indigo-500/30 group-hover:bg-indigo-500/40 transition-colors">
                <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-slate-200 font-medium text-lg tracking-wide">Internal audit procedures</span>
            </li>
            <li class="flex items-center group">
              <div class="shrink-0 w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center mr-5 border border-blue-500/30 group-hover:bg-blue-500/40 transition-colors">
                <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-slate-200 font-medium text-lg tracking-wide">Standard compliance verification</span>
            </li>
            <li class="flex items-center group">
              <div class="shrink-0 w-10 h-10 rounded-full bg-teal-500/20 flex items-center justify-center mr-5 border border-teal-500/30 group-hover:bg-teal-500/40 transition-colors">
                <svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-slate-200 font-medium text-lg tracking-wide">Pre-issue validation protocols</span>
            </li>
          </ul>
        </div>
        
        <div class="md:w-1/2 p-10 bg-linear-to-br from-blue-600 to-indigo-700 rounded-2xl relative overflow-hidden group shadow-[0_0_40px_rgba(37,99,235,0.2)]">
          <div class="absolute -right-10 -top-10 w-40 h-40 bg-white rounded-full blur-3xl opacity-10 justify-center group-hover:scale-150 transition-transform duration-700"></div>
          <div class="absolute -left-10 -bottom-10 w-32 h-32 bg-teal-400 rounded-full blur-2xl opacity-30 justify-center group-hover:scale-150 transition-transform duration-700 delay-100"></div>
          
          <div class="relative z-10 space-y-6">
            <h3 class="text-3xl font-bold text-white mb-2 tracking-tight">Our Objective</h3>
            <p class="text-blue-100/90 text-lg leading-relaxed mix-blend-plus-lighter pointer-events-none">
              To minimize RFIs, reduce revision cycles, and ultimately enhance fabrication efficiency for every project we support.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
