---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import ctaBgImg from '@assets/images/PHOTO 35.jpg';
---

<BaseLayout title="Contact Us - Duinz Engineering Services">
  <!-- Hero Section -->
  <section class="relative h-[60vh] min-h-[400px] flex items-center overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0">
      <Image 
        src={ctaBgImg}
        alt="Contact professional engineering team"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-linear-to-r from-slate-900/95 via-slate-900/80 to-slate-900/50"></div>
    </div>

    <!-- Content -->
    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center px-4 py-2 mb-6 bg-linear-to-r from-blue-600 to-teal-600 text-white text-sm font-semibold rounded-full shadow-lg">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Get In Touch
        </div>
        
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
          Contact <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 via-teal-400 to-blue-400">
            Us
          </span>
        </h1>
        
        <p class="text-xl text-slate-200 max-w-2xl mx-auto leading-relaxed">
          Ready to elevate your structural projects? Reach out to schedule a consultation with our detailing experts.
        </p>
      </div>
    </div>
  </section>
  
  <section class="py-24 bg-slate-50 relative">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        
        <!-- Contact Information -->
        <div class="space-y-12">
          <div>
            <h2 class="text-3xl font-bold text-slate-900 mb-6">Let's build something <span class="text-blue-600">extraordinary</span> together.</h2>
            <p class="text-lg text-slate-600 leading-relaxed">
              Whether you need high-precision 3D modeling, detailed fabrication drawings, or scalable offshore detailing teams, <span class="font-semibold text-slate-800">Duinz Engineering Services Pvt Ltd</span> is here to help.
            </p>
          </div>

          <div class="space-y-8 bg-white p-8 rounded-2xl border border-slate-100 shadow-xl shadow-slate-200/50">
            <!-- Offices / Locations -->
            <div class="flex items-start">
              <div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center shrink-0 mr-5">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 mb-1">Our Locations (India)</h3>
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-sm font-medium">Tiruchirappalli</span>
                  <span class="px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-sm font-medium">Pattukkottai</span>
                  <span class="px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-sm font-medium">Kochi</span>
                </div>
              </div>
            </div>

            <div class="w-full h-px bg-slate-100"></div>

            <!-- Email (Placeholder) -->
            <div class="flex items-start group cursor-pointer transition-all">
              <div class="w-12 h-12 rounded-full bg-teal-50 flex items-center justify-center shrink-0 mr-5 group-hover:bg-teal-600 transition-colors">
                <svg class="w-6 h-6 text-teal-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 mb-1">Email Us</h3>
                <a href="#" class="text-slate-600 hover:text-teal-600 transition-colors font-medium">info@duinz.com</a>
              </div>
            </div>

            <div class="w-full h-px bg-slate-100"></div>

            <!-- Phone (Placeholder) -->
            <div class="flex items-start group cursor-pointer transition-all">
              <div class="w-12 h-12 rounded-full bg-indigo-50 flex items-center justify-center shrink-0 mr-5 group-hover:bg-indigo-600 transition-colors">
                <svg class="w-6 h-6 text-indigo-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 mb-1">Call Us</h3>
                <a href="#" class="text-slate-600 hover:text-indigo-600 transition-colors font-medium">+91 (XXX) XXX-XXXX</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div id="contact-form-container" class="bg-white p-8 md:p-10 rounded-3xl shadow-2xl border border-slate-100 relative overflow-hidden scroll-mt-24">
          <div class="absolute top-0 right-0 p-32 bg-blue-50 rounded-full blur-3xl opacity-50 -mr-16 -mt-16 pointer-events-none"></div>

          <h3 class="text-2xl font-bold text-slate-900 mb-6 relative z-10">Send us a message</h3>

          <form
            id="contact-form"
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-6 relative z-10"
            novalidate
          >
            <!-- Netlify hidden inputs -->
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="firstName" class="block text-sm font-semibold text-slate-700 mb-2">First Name</label>
                <input name="firstName" type="text" id="firstName" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" placeholder="John" />
              </div>
              <div>
                <label for="lastName" class="block text-sm font-semibold text-slate-700 mb-2">Last Name</label>
                <input name="lastName" type="text" id="lastName" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" placeholder="Doe" />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-slate-700 mb-2">Email Address</label>
              <input name="email" type="email" id="email" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" placeholder="john@company.com" />
            </div>

            <div>
              <label for="projectType" class="block text-sm font-semibold text-slate-700 mb-2">Project Type</label>
              <div class="relative">
                <select name="projectType" id="projectType" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all bg-white appearance-none cursor-pointer">
                  <option value="" disabled selected>Select an option...</option>
                  <option value="3d-modeling">3D Structural Modeling</option>
                  <option value="shop-drawings">Shop & Fabrication Drawings</option>
                  <option value="erection-drawings">Erection Drawings</option>
                  <option value="other">Other Inquiry</option>
                </select>
                <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-500">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-slate-700 mb-2">Message</label>
              <textarea name="message" id="message" rows="4" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all resize-none" placeholder="Tell us about your project requirements..."></textarea>
            </div>

            <button
              type="submit"
              id="contact-submit-btn"
              class="w-full bg-linear-to-r from-blue-600 to-teal-600 hover:opacity-90 text-white font-bold py-4 px-8 rounded-lg shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              Submit Inquiry
            </button>
          </form>

          <!-- Success state (hidden by default) -->
          <div id="contact-success" class="hidden flex-col items-center justify-center py-16 text-center">
            <div class="w-20 h-20 rounded-full bg-teal-50 flex items-center justify-center mx-auto mb-6">
              <svg class="w-10 h-10 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-3">Message Sent!</h3>
            <p class="text-slate-500 max-w-sm">Thank you for reaching out. Our team will review your inquiry and get back to you shortly.</p>
          </div>
        </div>
        
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  #contact-success:not(.hidden) {
    display: flex;
  }
</style>

<script>
  const form       = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn  = document.getElementById('contact-submit-btn') as HTMLButtonElement;
  const successMsg = document.getElementById('contact-success')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }

    submitBtn.disabled = true;
    submitBtn.innerHTML = `
      <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
      </svg>
      Sending...`;

    try {
      const data = new FormData(form);
      await fetch('/', { method: 'POST', body: data });
      form.classList.add('hidden');
      successMsg.classList.remove('hidden');
    } catch {
      submitBtn.disabled = false;
      submitBtn.innerHTML = `
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
        Submit Inquiry`;
      alert('Something went wrong. Please try again or email us directly.');
    }
  });
</script>
