---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroBgImg from '@assets/images/PHOTO 35.jpg';
---

<BaseLayout
  title="Careers | Duinz Engineering Services"
  description="Join the Duinz Engineering team. Explore open opportunities and apply today — fill in your details and upload your resume."
>
  <!-- Hero section — text + perks unified, same as Projects page pattern -->
  <section class="relative flex flex-col overflow-hidden bg-slate-900">
    <!-- Background image + overlay -->
    <div class="absolute inset-0">
      <Image
        src={heroBgImg}
        alt="Join the Duinz Engineering team"
        class="w-full h-full object-cover"
        width={1920}
        height={1080}
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-linear-to-r from-slate-950/90 via-slate-900/80 to-slate-800/70"></div>
    </div>

    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8 py-4">
      <!-- Headline -->
      <div class="max-w-4xl mx-auto text-center min-h-[50vh] flex flex-col items-center justify-center">
        <div class="inline-flex items-center px-4 py-2 mb-6 bg-linear-to-r from-blue-600 to-teal-600 text-white text-sm font-semibold rounded-full shadow-lg">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Join Our Team
        </div>

        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 leading-tight">
          Build Your Career in
          <span class="block text-transparent bg-clip-text bg-linear-to-r from-blue-400 via-teal-400 to-blue-400 mt-2">
            Structural Steel
          </span>
        </h1>

        <p class="text-xl text-slate-200 max-w-2xl mx-auto leading-relaxed">
          We're always looking for talented structural engineers, BIM modelers, and detailers who are passionate about precision and quality.
        </p>
      </div>

      <!-- Perks grid — bottom of hero, inside same container, separated by top border -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-y-8 gap-x-6 pt-4 pb-10 max-w-4xl mx-auto">
        <div class="flex flex-col items-center text-center group">
          <div class="w-12 h-12 rounded-xl bg-blue-500/20 text-blue-400 border border-blue-500/30 flex items-center justify-center mb-3 shrink-0 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h4 class="text-white font-bold text-sm">Competitive Pay</h4>
          <p class="text-slate-400 text-xs mt-1 leading-relaxed">Market-aligned compensation</p>
        </div>
        <div class="flex flex-col items-center text-center group">
          <div class="w-12 h-12 rounded-xl bg-teal-500/20 text-teal-400 border border-teal-500/30 flex items-center justify-center mb-3 shrink-0 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h4 class="text-white font-bold text-sm">Fast Growth</h4>
          <p class="text-slate-400 text-xs mt-1 leading-relaxed">Clear career progression paths</p>
        </div>
        <div class="flex flex-col items-center text-center group">
          <div class="w-12 h-12 rounded-xl bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 flex items-center justify-center mb-3 shrink-0 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h4 class="text-white font-bold text-sm">Global Projects</h4>
          <p class="text-slate-400 text-xs mt-1 leading-relaxed">Work on international structures</p>
        </div>
        <div class="flex flex-col items-center text-center group">
          <div class="w-12 h-12 rounded-xl bg-blue-500/20 text-blue-400 border border-blue-500/30 flex items-center justify-center mb-3 shrink-0 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <h4 class="text-white font-bold text-sm">Tekla Training</h4>
          <p class="text-slate-400 text-xs mt-1 leading-relaxed">Structured onboarding & upskilling</p>
        </div>
      </div>
    </div>
  </section>


  <!-- Application Form Section -->
  <section class="py-16 bg-slate-50 relative overflow-hidden">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-blue-100 rounded-full mix-blend-multiply blur-3xl opacity-50 pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-teal-100 rounded-full mix-blend-multiply blur-3xl opacity-50 pointer-events-none"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto">

        <!-- Section heading -->
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-3">Apply Now</h2>
          <p class="text-slate-500 text-base max-w-lg mx-auto">Fill in your details below and attach your resume. Our team will review your application and get back to you shortly.</p>
        </div>

        <!-- Card -->
        <div class="bg-white rounded-3xl shadow-2xl border border-slate-100 p-8 md:p-12 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-blue-50 rounded-full blur-3xl opacity-60 -mr-16 -mt-16 pointer-events-none"></div>

          <form
            id="careers-form"
            name="careers"
            method="POST"
            enctype="multipart/form-data"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-8 relative z-10"
            novalidate
          >
            <!-- Netlify hidden inputs -->
            <input type="hidden" name="form-name" value="careers" />
            <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

            <!-- Personal Details -->
            <fieldset class="space-y-6">
              <legend class="text-lg font-bold text-slate-900 flex items-center gap-2 pb-2 border-b border-slate-100 w-full">
                <span class="w-7 h-7 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center shrink-0">1</span>
                Personal Details
              </legend>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="firstName" class="block text-sm font-semibold text-slate-700 mb-2">First Name <span class="text-red-500">*</span></label>
                  <input type="text" id="firstName" name="firstName" required
                    class="field w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all bg-slate-50 focus:bg-white"
                    placeholder="John" />
                </div>
                <div>
                  <label for="lastName" class="block text-sm font-semibold text-slate-700 mb-2">Last Name <span class="text-red-500">*</span></label>
                  <input type="text" id="lastName" name="lastName" required
                    class="field w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all bg-slate-50 focus:bg-white"
                    placeholder="Doe" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="email" class="block text-sm font-semibold text-slate-700 mb-2">Email Address <span class="text-red-500">*</span></label>
                  <input type="email" id="email" name="email" required
                    class="field w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all bg-slate-50 focus:bg-white"
                    placeholder="john@example.com" />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-semibold text-slate-700 mb-2">Phone Number</label>
                  <input type="tel" id="phone" name="phone"
                    class="field w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all bg-slate-50 focus:bg-white"
                    placeholder="+91 XXXXX XXXXX" />
                </div>
              </div>

              <div>
                <label for="location" class="block text-sm font-semibold text-slate-700 mb-2">Current Location</label>
                <input type="text" id="location" name="location"
                  class="field w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all bg-slate-50 focus:bg-white"
                  placeholder="City, Country" />
              </div>
            </fieldset>

            <!-- Professional Details -->
            <fieldset class="space-y-6">
              <legend class="text-lg font-bold text-slate-900 flex items-center gap-2 pb-2 border-b border-slate-100 w-full">
                <span class="w-7 h-7 rounded-full bg-teal-600 text-white text-xs font-bold flex items-center justify-center shrink-0">2</span>
                Professional Details
              </legend>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="role" class="block text-sm font-semibold text-slate-700 mb-2">Role Applying For <span class="text-red-500">*</span></label>
                  <div class="relative">
                    <select id="role" name="role" required
                      class="field w-full pl-4 pr-10 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all bg-slate-50 focus:bg-white appearance-none cursor-pointer">
                      <option value="" disabled selected>Select a role...</option>
                      <option value="Structural Steel Detailer">Structural Steel Detailer</option>
                      <option value="BIM Modeler (Tekla)">BIM Modeler (Tekla)</option>
                      <option value="Senior Checker / Reviewer">Senior Checker / Reviewer</option>
                      <option value="Project Coordinator">Project Coordinator</option>
                      <option value="CAD Drafter">CAD Drafter</option>
                      <option value="Other">Other</option>
                    </select>
                    <div class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-slate-400">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </div>
                  </div>
                </div>
                <div>
                  <label for="experience" class="block text-sm font-semibold text-slate-700 mb-2">Years of Experience <span class="text-red-500">*</span></label>
                  <div class="relative">
                    <select id="experience" name="experience" required
                      class="field w-full pl-4 pr-10 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all bg-slate-50 focus:bg-white appearance-none cursor-pointer">
                      <option value="" disabled selected>Select...</option>
                      <option value="Fresher (0–1 yr)">Fresher (0–1 yr)</option>
                      <option value="1–3 years">1–3 years</option>
                      <option value="3–5 years">3–5 years</option>
                      <option value="5–10 years">5–10 years</option>
                      <option value="10+ years">10+ years</option>
                    </select>
                    <div class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-slate-400">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </div>
                  </div>
                </div>
              </div>

              <div>
                <label for="software" class="block text-sm font-semibold text-slate-700 mb-2">Software Proficiency</label>
                <input type="text" id="software" name="software"
                  class="field w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all bg-slate-50 focus:bg-white"
                  placeholder="e.g. Tekla Structures, AutoCAD, Revit..." />
              </div>

              <div>
                <label for="coverNote" class="block text-sm font-semibold text-slate-700 mb-2">Cover Note</label>
                <textarea id="coverNote" name="coverNote" rows="4"
                  class="field w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all resize-none bg-slate-50 focus:bg-white"
                  placeholder="Tell us about yourself, your experience, and why you'd like to join Duinz Engineering..."></textarea>
              </div>
            </fieldset>

            <!-- Resume Upload -->
            <fieldset class="space-y-4">
              <legend class="text-lg font-bold text-slate-900 flex items-center gap-2 pb-2 border-b border-slate-100 w-full">
                <span class="w-7 h-7 rounded-full bg-indigo-600 text-white text-xs font-bold flex items-center justify-center shrink-0">3</span>
                Resume / CV
              </legend>

              <div
                id="drop-zone"
                class="relative border-2 border-dashed border-slate-300 rounded-2xl p-8 text-center transition-all duration-200 hover:border-blue-400 hover:bg-blue-50/50 cursor-pointer"
              >
                <input
                  type="file"
                  id="resume"
                  name="resume"
                  accept=".pdf,.doc,.docx"
                  required
                  class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                  aria-label="Upload resume"
                />
                <div id="drop-idle" class="space-y-2">
                  <div class="w-14 h-14 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-3">
                    <svg class="w-7 h-7 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                    </svg>
                  </div>
                  <p class="text-slate-700 font-semibold">Drag & drop your resume here</p>
                  <p class="text-slate-400 text-sm">or <span class="text-blue-600 font-semibold underline underline-offset-2">browse to upload</span></p>
                  <p class="text-slate-400 text-xs mt-2">Accepted formats: PDF, DOC, DOCX · Max 5 MB</p>
                </div>
                <div id="drop-selected" class="hidden items-center gap-3 justify-center">
                  <svg class="w-8 h-8 text-teal-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <div class="text-left">
                    <p id="file-name" class="text-slate-800 font-semibold text-sm"></p>
                    <p id="file-size" class="text-slate-400 text-xs"></p>
                  </div>
                  <button type="button" id="remove-file" class="ml-2 text-slate-400 hover:text-red-500 transition-colors" aria-label="Remove file">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                  </button>
                </div>
              </div>
            </fieldset>

            <!-- Submit -->
            <div class="pt-2">
              <button
                type="submit"
                id="submit-btn"
                class="w-full bg-linear-to-r from-blue-600 to-teal-600 hover:opacity-90 text-white font-bold py-4 px-8 rounded-xl shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                Submit Application
              </button>
              <p class="text-center text-slate-400 text-xs mt-4">We typically respond within 3–5 business days.</p>
            </div>
          </form>

          <!-- Success state (hidden by default) -->
          <div id="success-msg" class="hidden flex-col items-center justify-center py-16 text-center">
            <div class="w-20 h-20 rounded-full bg-teal-50 flex items-center justify-center mx-auto mb-6">
              <svg class="w-10 h-10 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-3">Application Received!</h3>
            <p class="text-slate-500 max-w-sm">Thank you for your interest in joining Duinz Engineering. We'll review your application and reach out within 3–5 business days.</p>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Red border only for text/email/tel inputs, not selects */
  input.field:invalid:not(:placeholder-shown) {
    border-color: #fca5a5;
  }
  #drop-zone.drag-over {
    border-color: #3b82f6;
    background-color: #eff6ff;
  }
  #success-msg:not(.hidden) {
    display: flex;
  }
</style>

<script>
  // ── File drop zone ──────────────────────────────────────────────────────────
  const dropZone   = document.getElementById('drop-zone')!;
  const fileInput  = document.getElementById('resume') as HTMLInputElement;
  const idleState  = document.getElementById('drop-idle')!;
  const selState   = document.getElementById('drop-selected')!;
  const fileNameEl = document.getElementById('file-name')!;
  const fileSizeEl = document.getElementById('file-size')!;
  const removeBtn  = document.getElementById('remove-file')!;

  function formatBytes(bytes: number) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function showFile(file: File) {
    fileNameEl.textContent = file.name;
    fileSizeEl.textContent = formatBytes(file.size);
    idleState.classList.add('hidden');
    selState.classList.remove('hidden');
    selState.classList.add('flex');
  }

  function clearFile() {
    fileInput.value = '';
    idleState.classList.remove('hidden');
    selState.classList.add('hidden');
    selState.classList.remove('flex');
  }

  fileInput.addEventListener('change', () => {
    if (fileInput.files?.[0]) showFile(fileInput.files[0]);
  });

  removeBtn.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    clearFile();
  });

  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-over'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    const file = e.dataTransfer?.files[0];
    if (file) {
      const dt = new DataTransfer();
      dt.items.add(file);
      fileInput.files = dt.files;
      showFile(file);
    }
  });

  // ── Form submission ─────────────────────────────────────────────────────────
  const form       = document.getElementById('careers-form') as HTMLFormElement;
  const submitBtn  = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMsg = document.getElementById('success-msg')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }

    submitBtn.disabled = true;
    submitBtn.innerHTML = `
      <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
      </svg>
      Submitting...`;

    try {
      const data = new FormData(form);
      await fetch('/', { method: 'POST', body: data });
      form.classList.add('hidden');
      successMsg.classList.remove('hidden');
    } catch {
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Submit Application';
      alert('Something went wrong. Please try again or email us directly.');
    }
  });
</script>
