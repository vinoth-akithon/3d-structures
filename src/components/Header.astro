---
import { NAVIGATION } from '@config/site';
import { Package } from 'lucide-react';
import MobileMenu from '@components/react/MobileMenu';
import { Image } from 'astro:assets';
import logo from '@assets/images/logo.svg';

const { currentPathname } = Astro.props;
const isActiveLink = (href: string) : boolean => { return href === currentPathname; }

---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/95 backdrop-blur-md shadow-sm">
  <nav class="container mx-auto flex h-22 items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <div class="flex items-center">
      <a href=`${import.meta.env.BASE_URL}` class="flex items-center group">
          <Image 
            src={logo} 
            alt="Duinz Engineering Services" 
            class="h-12 sm:h-16 w-auto object-contain max-w-[350px] sm:max-w-none lg:max-w-[800px]"
            loading="eager"
          />
      </a>
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex lg:items-center lg:space-x-1">
      {NAVIGATION.map((item) => {
        // Because Astro's BASE_URL includes trailing slash differently, we need to normalize 
        // Or simply construct the full path and check it against currentPathname
        const fullHref = `${import.meta.env.BASE_URL}${item.href === '/' ? '' : item.href.replace(/^\//, '')}`;
        const isActive = currentPathname === fullHref || currentPathname === fullHref + '/';
        return (
        <a
          href={fullHref}
          class={`px-4 py-2 text-sm font-medium text-slate-700 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-all relative group ${isActive ? 'nav-active' : ''}`}
        >
          {item.name}
        </a>
      );
      })}
    </div>

    <!-- CTA Button -->
    <div class="hidden lg:flex lg:items-center lg:space-x-4">
      <a
        href={`${import.meta.env.BASE_URL}contact#contact-form`}
        class="inline-flex items-center px-6 py-2.5 text-sm font-semibold text-white bg-linear-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 rounded-lg shadow-md hover:shadow-lg transition-all"
      >
        Work With Us
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <MobileMenu client:idle />
  </nav>
</header>
