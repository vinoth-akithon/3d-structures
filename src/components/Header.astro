---
import { NAVIGATION } from '@config/site';
import { Package } from 'lucide-react';
import MobileMenu from '@components/react/MobileMenu';
import { Image } from 'astro:assets';
import logo from '@assets/images/logo.jpeg';

const { currentPathname } = Astro.props;
const isActiveLink = (href: string) : boolean => { return href === currentPathname; }

---

<header class="sticky top-0 z-50 w-full border-b border-zinc-200 bg-white shadow-sm">
  <!-- Orange top accent bar -->
  <div class="absolute top-0 left-0 right-0 h-[3px] bg-orange-500"></div>
  <nav class="container mx-auto flex h-22 items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <div class="flex items-center">
      <a href=`${import.meta.env.BASE_URL}` class="flex items-center group transition-opacity group-hover:opacity-80">
        {/* Version 1: logo sits directly on light bg — white JPEG background blends naturally */}
        <Image
          src={logo}
          alt="3D Structure"
          class="h-9 sm:h-12 w-auto object-contain max-w-[280px] sm:max-w-none"
          loading="eager"
        />
      </a>
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex lg:items-center lg:space-x-1">
      {NAVIGATION.map((item) => {
        const fullHref = `${import.meta.env.BASE_URL}${item.href === '/' ? '' : item.href.replace(/^\//, '')}`;
        const isActive = currentPathname === fullHref || currentPathname === fullHref + '/';
        return (
        <a
          href={fullHref}
          class={`px-4 py-2 text-sm font-medium transition-colors relative group ${isActive ? 'text-orange-500' : 'text-zinc-600 hover:text-orange-500'}`}
        >
          {item.name}
          <span class={`absolute bottom-0 left-0 h-[2px] bg-orange-500 transition-all duration-300 ${isActive ? 'w-full' : 'w-0 group-hover:w-full'}`}></span>
        </a>
      );
      })}
    </div>

    <!-- CTA Button -->
    <div class="hidden lg:flex lg:items-center lg:space-x-4">
      <a
        href={`${import.meta.env.BASE_URL}contact#contact-form-container`}
        class="inline-flex items-center px-6 py-2.5 text-sm font-semibold text-white bg-orange-500 hover:bg-orange-600 rounded-lg shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
      >
        Work With Us
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <MobileMenu client:idle />
  </nav>
</header>
