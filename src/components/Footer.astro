---
import { NAVIGATION, SOCIAL_LINKS, SITE, CONTACT_INFO } from '@config/site';
import { Linkedin, Mail, MapPin } from 'lucide-react';
import { Image } from 'astro:assets';
import logo from '@assets/images/logo.jpeg';

const baseUrl = import.meta.env.BASE_URL;
const normalizeLink = (href: string) => `${baseUrl}${href.replace(/^\//, '')}`;
---

<footer class="bg-zinc-950 text-zinc-400">

  <!-- Orange top accent bar -->
  <div class="h-[3px] bg-orange-500"></div>

  <!-- Main Footer Grid -->
  <div class="container mx-auto px-4 pt-14 pb-0 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-4">

      <!-- Company Info -->
      <div class="lg:col-span-1 space-y-5">
        <a href={baseUrl} class="inline-flex group">
          <div class="bg-white rounded-lg px-3 py-1.5 shadow-md shadow-zinc-950/50 transition-opacity group-hover:opacity-90">
            <Image
              src={logo}
              alt="3D Structure"
              class="h-9 sm:h-12 w-auto object-contain max-w-[280px]"
            />
          </div>
        </a>
        <p class="text-sm leading-relaxed max-w-xs text-zinc-500">
          Precision structural steel detailing and BIM modeling — delivering fabrication-ready solutions for Australian steel fabricators and EPC contractors.
        </p>
        <div class="space-y-2.5">
          <div class="flex items-start text-sm gap-2.5">
            <MapPin className="w-4 h-4 mt-0.5 text-orange-500 shrink-0" />
            <span class="text-zinc-500">{CONTACT_INFO.locations.join(' | ')}</span>
          </div>
          <div class="flex items-center text-sm gap-2.5">
            <Mail className="w-4 h-4 text-orange-500 shrink-0" />
            <a href={`mailto:${CONTACT_INFO.email}`} class="text-zinc-500 hover:text-orange-400 transition-colors">{CONTACT_INFO.email}</a>
          </div>
        </div>
        <a
          target="_blank"
          href={SOCIAL_LINKS.linkedin}
          class="inline-flex w-9 h-9 items-center justify-center rounded-lg bg-zinc-800 text-zinc-400 hover:bg-orange-500 hover:text-white transition-all"
          aria-label="LinkedIn"
        >
          <Linkedin className="w-4 h-4" />
        </a>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-300 mb-2">Quick Links</h3>
        <div class="w-8 h-0.5 bg-orange-500 mb-5"></div>
        <ul class="space-y-2.5">
          {NAVIGATION.map((item) => (
            <li>
              <a
                href={normalizeLink(item.href)}
                class="text-sm text-zinc-500 hover:text-orange-400 transition-colors inline-flex items-center group"
              >
                <span class="w-0 group-hover:w-2 h-0.5 bg-orange-400 transition-all duration-200 mr-0 group-hover:mr-2 shrink-0"></span>
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-300 mb-2">Services</h3>
        <div class="w-8 h-0.5 bg-orange-500 mb-5"></div>
        <ul class="space-y-2.5">
          <li>
            <a href={normalizeLink('/services')} class="text-sm text-zinc-500 hover:text-orange-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-orange-400 transition-all duration-200 mr-0 group-hover:mr-2 shrink-0"></span>
              3D Structural Modeling
            </a>
          </li>
          <li>
            <a href={normalizeLink('/services')} class="text-sm text-zinc-500 hover:text-orange-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-orange-400 transition-all duration-200 mr-0 group-hover:mr-2 shrink-0"></span>
              Shop & Fabrication Drawings
            </a>
          </li>
          <li>
            <a href={normalizeLink('/services')} class="text-sm text-zinc-500 hover:text-orange-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-orange-400 transition-all duration-200 mr-0 group-hover:mr-2 shrink-0"></span>
              Erection Drawings
            </a>
          </li>
          <li>
            <a href={normalizeLink('/services')} class="text-sm text-zinc-500 hover:text-orange-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-orange-400 transition-all duration-200 mr-0 group-hover:mr-2 shrink-0"></span>
              Connection Detailing
            </a>
          </li>
        </ul>
      </div>

      <!-- Get Started -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-300 mb-2">Get Started</h3>
        <div class="w-8 h-0.5 bg-orange-500 mb-5"></div>
        <ul class="space-y-2.5 mb-8">
          <li>
            <a href={normalizeLink('/contact')} class="text-sm text-zinc-500 hover:text-orange-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-orange-400 transition-all duration-200 mr-0 group-hover:mr-2 shrink-0"></span>
              Contact Us
            </a>
          </li>
          <li>
            <a href={normalizeLink('/projects')} class="text-sm text-zinc-500 hover:text-orange-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-orange-400 transition-all duration-200 mr-0 group-hover:mr-2 shrink-0"></span>
              View Our Projects
            </a>
          </li>
          <li>
            <a href={normalizeLink('/careers')} class="text-sm text-zinc-500 hover:text-orange-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-orange-400 transition-all duration-200 mr-0 group-hover:mr-2 shrink-0"></span>
              Careers
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 py-6 border-t border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-zinc-600">
        &copy; {new Date().getFullYear()} {SITE.author}. All rights reserved.
      </p>
      <p class="text-xs text-zinc-700">Structural Steel Detailing & BIM Modeling — Australia</p>
    </div>
  </div>

</footer>
