---
import { NAVIGATION, SOCIAL_LINKS, SITE, CONTACT_INFO } from '@config/site';
import { Package, Linkedin, Twitter, Facebook, Mail, Phone, MapPin } from 'lucide-react';
import { Image } from 'astro:assets';
import logo from '@assets/images/logo.svg';

const baseUrl = import.meta.env.BASE_URL;
const normalizeLink = (href: string) => `${baseUrl}${href.replace(/^\//, '')}`;
---

<footer class="bg-slate-900 text-slate-300">
  <div class="container mx-auto px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-4">
      <!-- Company Info -->
      <div class="lg:col-span-1 space-y-6">
        <a href={baseUrl} class="flex items-center space-x-3 group">
          <div class="flex items-center justify-center p-2 rounded-lg bg-white bg-opacity-10 backdrop-blur-sm transition-transform group-hover:scale-105">
            <Image 
              src={logo} 
              alt="Duinz Engineering Services" 
              class="h-12 sm:h-14 lg:h-16 w-auto object-contain"
            />
          </div>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed max-w-xs">
          {SITE.description}
        </p>
        <div class="space-y-3">
          <div class="flex items-center text-sm text-slate-400">
            <MapPin className="w-4 h-4 mr-3 text-blue-500" />
            <span>{CONTACT_INFO.locations.join(' | ')}</span>
          </div>
          <div class="flex items-center text-sm text-slate-400">
            <Mail className="w-4 h-4 mr-3 text-blue-500" />
            <a href={`mailto:${CONTACT_INFO.email}`} class="hover:text-blue-400 transition-colors">{CONTACT_INFO.email}</a>
          </div>
          {CONTACT_INFO.phone && (
          <div class="flex items-center text-sm text-slate-400">
            <Phone className="w-4 h-4 mr-3 text-blue-500" />
            <a href={`tel:${CONTACT_INFO.phone}`} class="hover:text-blue-400 transition-colors">{CONTACT_INFO.phone}</a>
          </div>
          )}
        </div>
        <div class="flex space-x-4">
          <a
            href={SOCIAL_LINKS.linkedin}
            class="w-10 h-10 flex items-center justify-center rounded-lg bg-slate-800 text-slate-400 hover:bg-blue-600 hover:text-white transition-all"
            aria-label="LinkedIn"
          >
            <Linkedin className="w-5 h-5" />
          </a>
          <a
            href={SOCIAL_LINKS.twitter}
            class="w-10 h-10 flex items-center justify-center rounded-lg bg-slate-800 text-slate-400 hover:bg-blue-400 hover:text-white transition-all"
            aria-label="Twitter"
          >
            <Twitter className="w-5 h-5" />
          </a>
          <a
            href={SOCIAL_LINKS.facebook}
            class="w-10 h-10 flex items-center justify-center rounded-lg bg-slate-800 text-slate-400 hover:bg-blue-500 hover:text-white transition-all"
            aria-label="Facebook"
          >
            <Facebook className="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-6">
          Quick Links
        </h3>
        <ul class="space-y-3">
          {NAVIGATION.map((item) => (
            <li>
              <a
                href={normalizeLink(item.href)}
                class="text-sm text-slate-400 hover:text-blue-400 transition-colors inline-flex items-center group"
              >
                <span class="w-0 group-hover:w-2 h-0.5 bg-blue-400 transition-all mr-0 group-hover:mr-2"></span>
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-6">
          Services
        </h3>
        <ul class="space-y-3">
          <li>
            <a href={normalizeLink('/services')} class="text-sm text-slate-400 hover:text-blue-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-blue-400 transition-all mr-0 group-hover:mr-2"></span>
              3D Structural Modeling
            </a>
          </li>
          <li>
            <a href={normalizeLink('/services')} class="text-sm text-slate-400 hover:text-blue-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-blue-400 transition-all mr-0 group-hover:mr-2"></span>
              Shop & Fabrication Drawings
            </a>
          </li>
          <li>
            <a href={normalizeLink('/services')} class="text-sm text-slate-400 hover:text-blue-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-blue-400 transition-all mr-0 group-hover:mr-2"></span>
              Erection Drawings
            </a>
          </li>
          <li>
            <a href={normalizeLink('/services')} class="text-sm text-slate-400 hover:text-blue-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-blue-400 transition-all mr-0 group-hover:mr-2"></span>
              Connection Detailing
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-6">
          Get Started
        </h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={normalizeLink('/contact')} class="text-slate-400 hover:text-blue-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-blue-400 transition-all mr-0 group-hover:mr-2"></span>
              Contact Us
            </a>
          </li>
          <li>
            <a href={normalizeLink('/projects')} class="text-slate-400 hover:text-blue-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-blue-400 transition-all mr-0 group-hover:mr-2"></span>
              View Our Projects
            </a>
          </li>
        </ul>
        
        <div class="mt-8">
          <a
            href={normalizeLink('/contact#contact-form')}
            class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white bg-linear-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 rounded-lg shadow-lg hover:shadow-xl transition-all"
          >
            Work With Us
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-16 pt-8 border-t border-slate-800">
      <div class="flex flex-col md:flex-row items-center justify-between space-y-4 md:space-y-0">
        <p class="text-sm text-slate-400">
          &copy; {new Date().getFullYear()} {SITE.author}. All rights reserved.
        </p>
        <div class="flex items-center space-x-6 text-sm">
          <a href={normalizeLink('/')} class="text-slate-400 hover:text-blue-400 transition-colors">
            Privacy Policy
          </a>
          <span class="text-slate-700">•</span>
          <a href={normalizeLink('/')} class="text-slate-400 hover:text-blue-400 transition-colors">
            Terms of Service
          </a>
          <span class="text-slate-700">•</span>
          <a href={normalizeLink('/')} class="text-slate-400 hover:text-blue-400 transition-colors">
            Cookie Policy
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
